{
  "name": "itqan-website",
  "version": "0.1.0",
  "private": true,
  "description": "Corporate website for Itqan Pharmaceutical Industries (static Next.js export on Netlify)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "images": "node scripts/optimize-images.mjs",
    "preview": "netlify dev --offline",
    "postbuild": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "@fontsource/host-grotesk": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "node-html-parser": "^9.0.4",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  }
}
